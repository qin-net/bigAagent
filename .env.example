# Copy to `.env` in this directory (gitignored). Existing shell exports win.
# 复制为同目录 `.env` 后填写。已经 export 过的变量不会被覆盖。
# 改完后须重启 `python -m insightboard serve`。

# Required for live analyze / track / profile generation. Quote collection does not need it.
DEEPSEEK_API_KEY=

# Optional. Board default is deepseek-v4-flash.
# INSIGHTAGENT_MODEL=deepseek-v4-flash

# Optional paths (relative to repo root unless absolute).
# INSIGHTAGENT_DB_PATH=data/insightagent.db
# INSIGHTAGENT_KB_PATH=data/kb.db
# INSIGHTAGENT_ARTIFACT_ROOT=data/artifacts
# INSIGHTBOARD_RESEARCH_SPOOL=data/research_spool
